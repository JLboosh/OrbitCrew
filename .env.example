# gymcrew environment configuration
# --------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
#   cp .env.example .env
#
# Only EXPO_PUBLIC_* variables are visible to the app. They are inlined into the
# JS bundle at build time, so treat them as PUBLIC — never put privileged
# secrets (e.g. a Supabase service_role key) in this file.

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT (default)
# ---------------------------------------------------------------------------
# Run `npm run db:start` and copy the "API URL" and "anon key" it prints.
# The values below are the standard, non-secret local Supabase defaults and are
# identical on every developer machine.
#
# NOTE: use your machine's LAN IP (e.g. http://192.168.1.20:54321) instead of
# 127.0.0.1 when testing on a physical phone, since the device cannot reach
# your computer's loopback interface.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key-printed-by-supabase-start

# ---------------------------------------------------------------------------
# HOSTED PROJECT (staging / production)
# ---------------------------------------------------------------------------
# From the Supabase dashboard: Project Settings -> API
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# ---------------------------------------------------------------------------
# WEB DEPLOY (optional)
# ---------------------------------------------------------------------------
# Sub-path the web build is served from. Leave UNSET for local development and
# for any host that serves at the domain root (Netlify, Cloudflare Pages, Vercel).
#
# Set it only for GitHub Pages on a project repo, which serves from
# https://<user>.github.io/<repo>/ — every absolute asset path and the MapLibre
# worker URL has to carry that prefix or the page loads nothing. The deploy
# workflow sets this automatically from the repository name.
#
# EXPO_PUBLIC_BASE_PATH=/gymCrew-app
