{
  "name": "gymcrew",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:status": "supabase migration list --linked",
    "db:types": "supabase gen types typescript --linked > src/types/database.types.ts",
    "db:types:local": "supabase gen types typescript --local > src/types/database.types.ts",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint",
    "verify:db": "node scripts/verify-foundation.mjs && node scripts/verify-social.mjs && node scripts/verify-gyms.mjs && node scripts/verify-training.mjs",
    "verify:db:identity": "node scripts/verify-foundation.mjs",
    "verify:db:social": "node scripts/verify-social.mjs",
    "verify:db:gyms": "node scripts/verify-gyms.mjs",
    "verify:db:training": "node scripts/verify-training.mjs",
    "gyms:import": "node scripts/ingest-osm-gyms.mjs",
    "seed": "node scripts/seed-dev-data.mjs",
    "seed:reset": "node scripts/seed-dev-data.mjs --reset"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3"
  }
}
